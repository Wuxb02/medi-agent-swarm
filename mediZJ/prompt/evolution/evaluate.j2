  "unsupported_authority_claim": false,
  "attribution": [],
  "rationale": "简要理由",
  "evidence": [],
  "recommendations": [],
  "experiences": [{
      "type": "response_strategy|prompt_guidance|routing_rule|retrieval_hint|context_strategy",
      "scope": "private|global",
      "query_pattern": "适用问题模式",
      "content": "单一、可复用的行为策略",
      "applicability": ["适用条件"],
      "exclusions": ["排除条件"],
      "prerequisites": ["使用前必须确认的信息"],
      "safety_notes": "安全警示",
      "evidence_refs": ["可核验来源"],
      "risk_level": "low|medium|high",
      "capability_tag": "可选能力标签",
      "contains_personal_data": false,
      "expires_at": null
  }]
}
若不应沉淀经验，将 experiences 设为空数组。
