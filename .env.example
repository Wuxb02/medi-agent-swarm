# LLM 配置（OpenAI 兼容 API）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_NAME=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
INTENT_CLASSIFIER_MODE=jev
# 双轨记忆提取独立于意图识别模式，也使用以下 JEV 凭据和模型。
# shadow 模式仍由 LLM 路由；业务代码未显式授权时不会向 JEV 发送问句。
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_OTHERS_THRESHOLD=0.9
INTENT_LLM_INPUT_USD_PER_M=
INTENT_LLM_OUTPUT_USD_PER_M=
MEDICAL_SEMANTIC_VERIFY_ENABLED=true

# 知识版本与数据生命周期
KNOWLEDGE_ARCHIVE_RETENTION_DAYS=365
DATA_LIFECYCLE_ENABLED=true
DATA_LIFECYCLE_INTERVAL_SECONDS=86400

# 并发与超时配置
LLM_MAX_CONCURRENCY=16   # LLM 全局并发上限（保护上游 API 配额）
LLM_TIMEOUT=60           # 单次 LLM 请求超时（秒）

# 登录配置（免密登录，仅适用于本地或可信网络）
MEDIZJ_ADMIN_USERNAME=admin
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
REQUEST_TIMEOUT=300      # 单次问答请求总超时（秒），高并发排队场景需覆盖 200s 量级

# Embedding 模型配置（来源：HuggingFace Hub，首次加载自动下载，之后走本地缓存 ~/.cache/huggingface/hub/）
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 必填基础设施配置（短期记忆只使用 Redis）
MYSQL_PASSWORD=change_me_mysql
MYSQL_ROOT_PASSWORD=change_me_root
MINIO_ROOT_PASSWORD=change_me_minio
MYSQL_URL=mysql+asyncmy://medizj:change_me_mysql@mysql:3306/medizj
REDIS_URL=redis://redis:6379/0
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
KNOWLEDGE_COLLECTION=medical_knowledge_v1
SESSION_COLLECTION=session_summaries_v1
MYSQL_POOL_SIZE=20
REDIS_TIMEOUT=5
APP_ENVIRONMENT=production
UPLOAD_DIR=/data/uploads
SHORT_TERM_TTL=3600
RUN_CONCURRENCY=16
RUN_QUEUE_LIMIT=32
RUN_QUEUE_TIMEOUT=30
USER_RUN_LIMIT=2
RUN_TIMEOUT=300
LLM_QUEUE_LIMIT=32
LLM_QUEUE_TIMEOUT=10
EVENT_SUBSCRIBER_LIMIT=64
SLOW_CLIENT_TIMEOUT=30
QUESTIONNAIRE_TTL=86400
LEASE_SECONDS=60
HEARTBEAT_SECONDS=15
BACKGROUND_LLM_LIMIT=4

# Vision 多模态模型配置（用于图片解析，可选；未设置则回退到主 LLM 配置）
VISION_MODEL_NAME=gpt-4o
VISION_API_KEY=
VISION_BASE_URL=
VISION_TEMPERATURE=0.3
VISION_MAX_TOKENS=2048

# AB Test Baseline 配置（同模型无包装，用于对比评估）
BASELINE_LLM_API_KEY=your_baseline_api_key_here
BASELINE_LLM_BASE_URL=https://api.example.com/v1
BASELINE_LLM_MODEL_NAME=gpt-4o

# 自进化闭环
EVOLUTION_ENABLED=true
EVOLUTION_SAMPLE_RATE=0.2
EVOLUTION_OBSERVATION_RATE=0.2
EVOLUTION_POLL_INTERVAL=2
EVOLUTION_JUDGE_TIMEOUT=120
EVOLUTION_MEDICAL_EXPIRY_DAYS=180
EVOLUTION_GLOBAL_MIN_SUPPORT=3
EVOLUTION_TRUSTED_SOURCES=临床指南数据库,ICD-10疾病编码数据库
EVOLUTION_TRUSTED_DOMAINS=
